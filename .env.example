# --- Required ---
DATABASE_URL=postgresql://app:app@localhost:5432/astro
# 32+ random characters; signs session cookies and hashes login codes
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
# Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Public URL of the app (used in Stripe redirects and the Telegram /web command)
APP_URL=http://localhost:3000

# --- Agent tuning (optional) ---
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium        # chat replies: low | medium | high | xhigh | max
# FORECAST_EFFORT=low        # forecasts and conversation summaries
# FREE_MESSAGES=5            # free chat messages for new accounts

# --- Email (login codes, forecasts). Without SMTP_URL emails are printed to the server log. ---
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Jyoti <hello@example.com>"

# --- Telegram bot ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=your_bot
# TELEGRAM_WEBHOOK_SECRET=random-string

# --- Stripe (web payments) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS=price_...
# STRIPE_PRICE_PRO=price_...

# --- Scheduler ---
# CRON_SECRET=random-string   # GET /api/cron/tick with "Authorization: Bearer $CRON_SECRET" hourly

# --- Branding / services (optional) ---
# NEXT_PUBLIC_BRAND_NAME=Jyoti
# NEXT_PUBLIC_ASSISTANT_NAME=Jyoti
# GEOCODER_URL=https://geocoding-api.open-meteo.com/v1/search
